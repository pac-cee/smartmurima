# ---- Database ----
POSTGRES_DB=smartmurima
POSTGRES_USER=smartmurima
POSTGRES_PASSWORD=smartmurima
DATABASE_URL=postgres://smartmurima:smartmurima@db:5432/smartmurima

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@smartmurima.rw
PGADMIN_PASSWORD=admin

# ---- Django ----
DJANGO_SECRET_KEY=change-me-in-production
# The compose stack is a local dev stack: dev settings turn on DEBUG and accept
# any browser origin (localhost, 127.0.0.1, a LAN IP), so the frontend is not
# blocked by CORS depending on which host name you open it with. Deployments
# keep the image default, config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# SMS delivery for OTP codes sent to a phone number.
# Blank SMS_PROVIDER -> codes are printed in the backend logs (dev default).
# Africa's Talking: set SMS_PROVIDER=africastalking, then
#   sandbox  -> SMS_USERNAME=sandbox and the sandbox API key; messages show up
#               in the simulator at https://developers.africastalking.com/simulator
#               (nothing reaches a real handset, and it is free)
#   live     -> SMS_USERNAME=<your app username> and the live API key.
# Leave SMS_SENDER_ID blank unless the account owns a registered sender ID --
# Africa's Talking rejects the message otherwise. SMS_API_URL overrides the
# endpoint if you ever need to point somewhere else.
SMS_PROVIDER=
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=


# Email delivery for OTP codes sent to an email address.
# Default: the mailpit container in docker-compose -- codes are really sent over
# SMTP and read at http://localhost:8025, with no mail account needed.
# To send outside the machine (e.g. Gmail): EMAIL_HOST=smtp.gmail.com,
# EMAIL_PORT=587, EMAIL_USE_TLS=True, EMAIL_HOST_USER=<address>,
# EMAIL_HOST_PASSWORD=<app password>. Blank EMAIL_HOST falls back to printing
# the code in the backend logs.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SmartMurima <no-reply@smartmurima.rw>

# ---- MQTT ----
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=smartmurima/+/telemetry

# ---- IoT simulator (profile: iot) ----
SIM_DEVICES=SM-NODE-01,SM-NODE-02
SIM_INTERVAL=10

# ---- Ollama / RAG ----
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=qwen2.5:0.5b
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=4

# ---- Weather ----
WEATHER_API_URL=
WEATHER_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_MOCKING=disabled
